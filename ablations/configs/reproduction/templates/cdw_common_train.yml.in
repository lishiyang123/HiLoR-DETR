__include__: [@BASE_CONFIG@]

num_classes: 5
remap_mscoco_category: False

HGNetv2:
  pretrained: False

optimizer:
  type: AdamW
  params:
    -
      params: '^(?=.*backbone)(?!.*bn).*$'
      lr: 0.00001
    -
      params: '^(?=.*(?:norm|bn)).*$'
      weight_decay: 0.
  lr: 0.0001
  betas: [0.9, 0.999]
  weight_decay: 0.0001

epoches: 102
warmup_iter: 20

train_dataloader:
  dataset:
    img_folder: @TRAIN_IMAGES@
    ann_file: @TRAIN_ANN@
  total_batch_size: 8
  num_workers: 4

val_dataloader:
  dataset:
    img_folder: @VAL_IMAGES@
    ann_file: @VAL_ANN@
  total_batch_size: 8
  num_workers: 4

PostProcessor:
  qccr_enabled: False
  umr_enabled: False
